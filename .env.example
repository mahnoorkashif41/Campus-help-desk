# Copy this file to ".env" (same folder) and fill in real values. NEVER commit ".env".
# Both Next.js and the Prisma tool read ".env".

# Supabase: Project Settings > Database > Connection string.
# DATABASE_URL: "Transaction pooler" string (port 6543). Used by the running app.
DATABASE_URL=
# DIRECT_URL: "Session pooler" string (port 5432). Used only for migrations. Works on IPv4 networks.
DIRECT_URL=

# Used in Stage C (images) - leave empty for now.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-images

# Used in Stage D (admin login) - leave empty for now.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
